# ============================================
# CalenBaq Backend — Variables de Entorno
# Copia este archivo como .env y completa los valores
# ============================================

# Server
PORT=4000
NODE_ENV=development

# Database (debe coincidir con docker-compose.yml)
DATABASE_URL="postgresql://calenbaq:calenbaq_password@localhost:5432/calenbaq"

# JWT — CAMBIA ESTOS VALORES EN PRODUCCIÓN
