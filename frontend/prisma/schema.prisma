generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  slug               String          @unique
  nit                String?
  description        String?
  address            String?
  phone              String?
  email              String?
  currency           String          @default("COP")
  timezone           String          @default("America/Bogota")
  logoUrl            String?         @map("logo_url")
  companyName        String?         @map("company_name")
  faviconUrl         String?         @map("favicon_url")
  subscriptionStatus String          @default("ACTIVE") @map("subscription_status")
  planName           String          @default("PRO") @map("plan_name")
  isActive           Boolean         @default(true) @map("is_active")
  maxUsers           Int             @default(5) @map("max_users")
  activeModules      String[]        @default(["pos", "inventario", "categorias", "ventas", "usuarios", "modulos", "configuracion", "analitica"]) @map("active_modules")
  settings           Json?           @default("{\"taxRate\": 0, \"receiptFooter\": \"¡Gracias por su compra en eTshop!\", \"allowNegativeStock\": false}")
  ownerId            String?         @map("owner_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner              User?           @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  users              User[]          @relation("CompanyUsers")
  roleProfiles       RoleProfile[]
  companyModules     CompanyModule[]
  categories         Category[]
  products           Product[]
  stockMovements     StockMovement[]
  sales              Sale[]
  saleItems          SaleItem[]

  @@map("companies")
}

model User {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username         String
  email            String?
  phone            String?
  phoneCode        String?         @default("+57") @map("phone_code")
  passwordHash     String          @map("password_hash")
  role             Role            @default(CASHIER)
  name             String          @db.VarChar(100)
  avatarUrl        String?         @map("avatar_url")
  isActive         Boolean         @default(true) @map("is_active")
  failedAttempts   Int             @default(0) @map("failed_attempts")
  lockUntil        DateTime?       @map("lock_until") @db.Timestamptz(6)
  refreshToken     String?         @map("refresh_token")
  refreshTokenExp  DateTime?       @map("refresh_token_exp") @db.Timestamptz(6)
  currentSessionId String?         @map("current_session_id")
  companyId        String?         @map("company_id") @db.Uuid
  roleProfileId    String?         @map("role_profile_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company          Company?        @relation("CompanyUsers", fields: [companyId], references: [id], onDelete: Cascade)
  ownedCompanies   Company[]       @relation("CompanyOwner")
  roleProfile      RoleProfile?    @relation(fields: [roleProfileId], references: [id], onDelete: SetNull)
  sales            Sale[]
  stockMovements   StockMovement[]

  @@unique([username, companyId])
  @@map("users")
}

model RoleProfile {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  modules             String[] @default([])
  isActive            Boolean  @default(true) @map("is_active")
  isGlobalViewEnabled Boolean  @default(true) @map("is_global_view_enabled")
  companyId           String   @map("company_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users               User[]

  @@map("role_profiles")
}

model Module {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String          @unique
  name           String
  description    String?
  icon           String?         @default("Package")
  isCore         Boolean         @default(false) @map("is_core")
  sortOrder      Int             @default(0) @map("sort_order")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  companyModules CompanyModule[]

  @@map("modules")
}

model CompanyModule {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  moduleId    String   @map("module_id") @db.Uuid
  isEnabled   Boolean  @default(true) @map("is_enabled")
  config      Json?    @default("{}")
  activatedAt DateTime @default(now()) @map("activated_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([companyId, moduleId])
  @@map("company_modules")
}

model Category {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  name        String
  description String?
  color       String    @default("#10b981")
  icon        String?   @default("Tag")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([name, companyId])
  @@map("categories")
}

model Product {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String          @map("company_id") @db.Uuid
  categoryId     String?         @map("category_id") @db.Uuid
  name           String
  description    String?
  sku            String?
  barcode        String?
  costPrice      Decimal         @default(0.00) @map("cost_price") @db.Decimal(12, 2)
  salePrice      Decimal         @default(0.00) @map("sale_price") @db.Decimal(12, 2)
  taxRate        Decimal         @default(0.00) @map("tax_rate") @db.Decimal(5, 2)
  stock          Decimal         @default(0.00) @db.Decimal(12, 2)
  minStock       Decimal         @default(5.00) @map("min_stock") @db.Decimal(12, 2)
  unit           String          @default("UND")
  imageUrl       String?         @map("image_url")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@index([companyId, barcode])
  @@index([companyId, sku])
  @@index([companyId, name])
  @@map("products")
}

model StockMovement {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String            @map("company_id") @db.Uuid
  productId     String            @map("product_id") @db.Uuid
  userId        String?           @map("user_id") @db.Uuid
  type          StockMovementType
  quantity      Decimal           @db.Decimal(12, 2)
  previousStock Decimal           @map("previous_stock") @db.Decimal(12, 2)
  newStock      Decimal           @map("new_stock") @db.Decimal(12, 2)
  referenceId   String?           @map("reference_id") @db.Uuid
  notes         String?
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product       Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, productId, createdAt(sort: Desc)])
  @@map("stock_movements")
}

model Sale {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String        @map("company_id") @db.Uuid
  saleNumber     String        @map("sale_number")
  userId         String        @map("user_id") @db.Uuid
  customerName   String?       @default("Cliente Mostrador") @map("customer_name")
  customerDoc    String?       @map("customer_doc")
  customerPhone  String?       @map("customer_phone")
  subtotal       Decimal       @default(0.00) @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount Decimal       @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  total          Decimal       @default(0.00) @db.Decimal(12, 2)
  paymentMethod  PaymentMethod @default(CASH) @map("payment_method")
  amountReceived Decimal       @default(0.00) @map("amount_received") @db.Decimal(12, 2)
  changeAmount   Decimal       @default(0.00) @map("change_amount") @db.Decimal(12, 2)
  status         SaleStatus    @default(COMPLETED)
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  items          SaleItem[]

  @@unique([saleNumber, companyId])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("sales")
}

model SaleItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  saleId      String   @map("sale_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  productName String   @map("product_name")
  productSku  String?  @map("product_sku")
  quantity    Decimal  @db.Decimal(12, 2)
  unitPrice   Decimal  @default(0.00) @map("unit_price") @db.Decimal(12, 2)
  unitCost    Decimal  @default(0.00) @map("unit_cost") @db.Decimal(12, 2)
  discount    Decimal  @default(0.00) @db.Decimal(12, 2)
  subtotal    Decimal  @default(0.00) @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([companyId, productId])
  @@map("sale_items")
}

enum Role {
  SUPERADMIN
  ADMIN
  CASHIER
  INVENTORY
  CLIENT
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  MIXED
  CREDIT
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  REFUNDED
}

enum StockMovementType {
  INITIAL
  SALE
  PURCHASE
  ADJUSTMENT
  RETURN
  CANCELLED_SALE
}
